# University of Kamalia QR Quiz Competition — environment example
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# The application will not start in production without a strong ADMIN_JWT_SECRET.

# PostgreSQL connection string (Prisma reads this at runtime).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Public base URL of the deployed application. Used to build QR URLs.
# MUST be the real public HTTPS origin in production (e.g. https://quiz.example.com).
# Leave http://localhost:3000 for local development only.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Env-only secret used to sign admin JWT session tokens. Server-side only.
# Generate a long random value, e.g. via `openssl rand -base64 48`. Required in production.
ADMIN_JWT_SECRET="replace-with-a-long-random-secret"

# Initial admin account created on first seed. Never use a default password.
ADMIN_INITIAL_EMAIL="admin@kamalia.edu.pk"
ADMIN_INITIAL_PASSWORD="replace-with-a-strong-password"

# Optional: when running `npm run db:seed`, set this to force-reset the existing
# admin password hash (useful for rotating credentials). Not required for normal use.
# RESET_ADMIN_PASSWORD=""